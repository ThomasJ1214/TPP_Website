# ─────────────────────────────────────────────────────
# Third Proof Pizzeria — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=https://thirdproofpizzeria.com

# ── Supabase ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — NEVER expose this to the browser.
# Used server-side only (API routes). Not NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Maps (optional) ───────────────────────────
# Full iframe src URL from Google Maps "Embed a map" → Copy HTML.
# If not set, a default embed URL for the restaurant address is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
